{
  "name": "foododer",
  "private": true,
  "version": "0.1.0",
  "description": "Say what you want to cook; it scales the recipe, checks your stock, builds a supermarket basket and waits for your approval.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "dev:api": "pnpm --filter @foododer/api dev",
    "dev:web": "pnpm --filter @foododer/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "seed": "pnpm --filter @foododer/api seed"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
